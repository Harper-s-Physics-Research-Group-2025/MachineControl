(* Beginning of Notebook Content *)
Notebook[{
Cell[TextData[{
  "Josh 2.0 Lab Equipment Controller - Test Interface\n",
  "Version 1.0\nDate: May 28, 2026\nAuthors: Josh Darrow, Samuel Ntadom"
}], "Title",
 CellChangeTimes->{{3.91., 3.91.}}],

Cell[TextData[{
  "This notebook provides a test interface for the LabEquipmentController DLL. \
It demonstrates how to load and use the library from Mathematica."
}], "Subtitle"],

Cell["Setup and Configuration", "Section"],

Cell[TextData[{
  "Set the path to the DLL. Adjust based on your build location:"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dllPath", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"NotebookDirectory", "[", "]", ",", "\"\<..\\..\\Josh_Controller\\build\\bin\\LabController.dll\>\""}], 
     "}"}], "]"}]}], ";"}]], "Input"],

Cell[TextData[{
  "Verify the DLL exists:"
}], "Text"],

Cell[BoxData[
 RowBox[{"FileExistsQ", "[", "dllPath", "]"}]], "Input"],

Cell["Load the Library", "Section"],

Cell[TextData[{
  "Load the DLL using LibraryLink:"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lib", "=", 
   RowBox[{"LibraryLoad", "[", "dllPath", "]"}]}], ";"}]], "Input"],

Cell[BoxData[
 RowBox[{"LibraryInformation", "[", "lib", "]"}]], "Input"],

Cell["Define Function Wrappers", "Section"],

Cell[TextData[{
  "Create Mathematica wrapper functions for the C++ API:"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bathOn", "=", 
   RowBox[{"LibraryFunction", "[", 
    RowBox[{"lib", ",", "\"\<bath_on\>\"", ",", 
     RowBox[{"{", "\"\<UTF8String\>\"", "}"}], ",", "\"\<Void\>\""}], "]"}]}], 
  ";"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bathOff", "=", 
   RowBox[{"LibraryFunction", "[", 
    RowBox[{"lib", ",", "\"\<bath_off\>\"", ",", 
     RowBox[{"{", "\"\<UTF8String\>\"", "}"}], ",", "\"\<Void\>\""}], "]"}]}], 
  ";"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"servoMotorHome", "=", 
   RowBox[{"LibraryFunction", "[", 
    RowBox[{"lib", ",", "\"\<servo_motor_home\>\"", ",", 
     RowBox[{"{", "}"}], ",", "\"\<Integer\>\""}], "]"}]}], 
  ";"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"servoMotorReadPosition", "=", 
   RowBox[{"LibraryFunction", "[", 
    RowBox[{"lib", ",", "\"\<servo_motor_read_position\>\"", ",", 
     RowBox[{"{", "}"}], ",", "\"\<Integer\>\""}], "]"}]}], 
  ";"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tempControlDump", "=", 
   RowBox[{"LibraryFunction", "[", 
    RowBox[{"lib", ",", "\"\<temperature_control_dump\>\"", ",", 
     RowBox[{"{", "\"\<UTF8String\>\"", "}"}], ",", "\"\<Integer\>\""}], "]"}]}], 
  ";"}]], "Input"],

Cell["Testing Bath Control", "Section"],

Cell[TextData[{
  "Set COM port for water bath (change to your actual port):"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bathPort", "=", "\"\<COM3\>\""}], ";"}]], "Input"],

Cell[TextData[{
  "Turn the bath on:"
}], "Text"],

Cell[BoxData[
 RowBox[{"bathOn", "[", "bathPort", "]"}]], "Input"],

Cell[TextData[{
  "Query bath status (dumps current temperature and setpoint):"
}], "Text"],

Cell[BoxData[
 RowBox[{"bathOff", "[", "bathPort", "]"}]], "Input"],

Cell["Testing Servo Motor Control", "Section"],

Cell[TextData[{
  "Home the servo motors (returns 0 on success):"
}], "Text"],

Cell[BoxData[
 RowBox[{"servoMotorHome", "[", "]"}]], "Input"],

Cell[TextData[{
  "Read current servo position in mm:"
}], "Text"],

Cell[BoxData[
 RowBox[{"servoMotorReadPosition", "[", "]"}]], "Input"],

Cell["Testing Temperature Control", "Section"],

Cell[TextData[{
  "Set COM port for temperature controller:"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tempPort", "=", "\"\<COM4\>\""}], ";"}]], "Input"],

Cell[TextData[{
  "Dump all temperature controller parameters (returns 0 on success):"
}], "Text"],

Cell[BoxData[
 RowBox[{"tempControlDump", "[", "tempPort", "]"}]], "Input"],

Cell["Error Handling", "Section"],

Cell[TextData[{
  "Most functions return 0 on success or an error code on failure. \
Example error codes:\n",
  "  1001 - Invalid COM port\n",
  "  1002 - Value out of range\n",
  "\nCheck return values like this:"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"result", "=", 
   RowBox[{"servoMotorHome", "[", "]"}]}], ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"result", "===", "0"}], ",", 
    RowBox[{"Print", "[", "\"\<Motor homing successful\>\"", "]"}], ",", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Motor homing failed with error code: \>\"", "<>", 
      RowBox[{"ToString", "[", "result", "]"}]}], "]"}]}], "]"}]}]], "Input"],

Cell["Cleanup", "Section"],

Cell[TextData[{
  "Unload the library when done:"
}], "Text"],

Cell[BoxData[
 RowBox[{"LibraryUnload", "[", "lib", "]"}]], "Input"],

Cell[TextData[{
  "Note: Some device connections may require proper cleanup sequences. \
Always turn off equipment before unloading."
}], "Text"]
},
WindowSize->{1024, 768},
WindowMargins->{{0, Automatic}, {Automatic, 0}},
FrontEndVersion->"14.0 for Microsoft Windows (64-bit) (December 13, 2023)",
StyleDefinitions->"Default.nb",
ExpressionUUID->"1a2b3c4d-5e6f-7g8h-9i0j-1k2l3m4n5o6p"
]

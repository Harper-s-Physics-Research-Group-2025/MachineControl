Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Extract", " ", "the", " ", "sequential", " ", "results"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"reportKeys", "=", 
     RowBox[{"Keys", "[", 
      RowBox[{"report", "[", "\"\<TestResults\>\"", "]"}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{"gridData", "=", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"key", "=", 
              RowBox[{"reportKeys", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ",", 
             RowBox[{"res", "=", 
              RowBox[{
               RowBox[{"report", "[", "\"\<TestResults\>\"", "]"}], "[", 
               RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"(*", 
             RowBox[{"1.", " ", "Test", " ", "ID", " ", "string"}], "*)"}], 
            RowBox[{
             RowBox[{"res", "[", "\"\<TestID\>\"", "]"}], ",", 
             RowBox[{"(*", 
              RowBox[{"2.", " ", "Visual", " ", 
               RowBox[{"Pass", "/", "Fail"}], " ", "Status"}], "*)"}], 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"res", "[", "\"\<Outcome\>\"", "]"}], 
                "===", "\"\<Success\>\""}], ",", 
               RowBox[{"Item", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<PASS\>\"", ",", "White", ",", "Bold"}], "]"}], 
                 ",", 
                 RowBox[{"Background", "->", 
                  RowBox[{"Darker", "[", 
                   RowBox[{"Green", ",", "0.2"}], "]"}]}], ",", 
                 RowBox[{"Alignment", "->", "Center"}]}], "]"}], ",", 
               RowBox[{"Item", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<FAIL\>\"", ",", "White", ",", "Bold"}], "]"}], 
                 ",", 
                 RowBox[{"Background", "->", "Red"}], ",", 
                 RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], "]"}], ",", 
             RowBox[{"(*", 
              RowBox[{"3.", " ", "Actual", " ", "Result", " ", 
               RowBox[{"(", 
                RowBox[{"Function", " ", "Output"}], ")"}]}], "*)"}], 
             RowBox[{"res", "[", "\"\<ActualOutput\>\"", "]"}], ",", 
             RowBox[{"(*", 
              RowBox[{"4.", " ", "Expected", " ", 
               RowBox[{"Result", "/", "Range"}], " ", "Check", " ", 
               "Formula"}], "*)"}], 
             RowBox[{"res", "[", "\"\<ExpectedOutput\>\"", "]"}]}], "}"}]}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "reportKeys", "]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Test ID\>\"", ",", "\"\<Status\>\"", 
         ",", "\"\<Actual Result\>\"", ",", "\"\<Expected Result\>\""}], 
        "}"}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Render", " ", "the", " ", "clean", " ", "evaluation", " ", 
     "report", " ", "window"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"CreateDocument", "[", 
     RowBox[{
      RowBox[{"Grid", "[", 
       RowBox[{"gridData", ",", 
        RowBox[{"Frame", "->", "All"}], ",", 
        RowBox[{"Alignment", "->", "Left"}], ",", 
        RowBox[{"Background", "->", 
         RowBox[{"{", 
          RowBox[{"None", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Lighter", "[", 
              RowBox[{"Gray", ",", "0.8"}], "]"}], ",", 
             RowBox[{"{", "White", "}"}]}], "}"}]}], "}"}]}], ",", 
        RowBox[{"ItemStyle", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<Text\>\"", ",", 
           RowBox[{"FontSize", "->", "12"}]}], "}"}]}], ",", 
        RowBox[{"DividerStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"Gray", ",", "Thin"}], "]"}]}]}], "]"}], ",", 
      RowBox[{"WindowSize", "->", 
       RowBox[{"{", 
        RowBox[{"900", ",", "450"}], "}"}]}], ",", 
      RowBox[{
      "WindowTitle", 
       "->", "\"\<Hardware Test Suite Verification Grid\>\""}]}], "]"}], 
    ";"}]}]}]], "Input",
